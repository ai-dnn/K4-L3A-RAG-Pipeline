# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# Generation qua OpenRouter (dùng chung OPENROUTER_API_KEY bên dưới)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: openrouter | sentence_transformers
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=baai/bge-m3
OPENROUTER_API_KEY=

# Optional services
PAGEINDEX_API_KEY=
# Optional: font TTF hỗ trợ tiếng Việt để tạo PDF upload PageIndex
PAGEINDEX_FONT_PATH=
JINA_API_KEY=

# Ngưỡng thử nghiệm 4 query in-domain + 4 out-of-domain; cần đánh giá thêm.
SCORE_THRESHOLD=0.5978
